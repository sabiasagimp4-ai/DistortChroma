<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>

    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <PathMap>$(RepoRoot)=.</PathMap>

    <ShaderSource>$(MSBuildProjectDirectory)\Shaders\DistortChromaShader.hlsl</ShaderSource>
    <ShaderBinary>$(MSBuildProjectDirectory)\Shaders\DistortChromaShader.cso</ShaderBinary>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Shaders\DistortChromaShader.cso" />
    <EmbeddedResource Include="Shaders\DistortChromaShader.cso" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Controls">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.Controls.dll</HintPath>
    </Reference>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
    </Reference>
    <Reference Include="SharpGen.Runtime">
      <HintPath>$(YMM4DirPath)SharpGen.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="SharpGen.Runtime.COM">
      <HintPath>$(YMM4DirPath)SharpGen.Runtime.COM.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.Direct2D1">
      <HintPath>$(YMM4DirPath)Vortice.Direct2D1.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>$(YMM4DirPath)Vortice.DirectX.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.Mathematics">
      <HintPath>$(YMM4DirPath)Vortice.Mathematics.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- .hlsl が .cso より新しいときだけ再コンパイルする。
       .cso はリポジトリに含まれているので、fxc.exe が無い環境でもビルドは通る。 -->
  <Target Name="ShaderBuild" BeforeTargets="BeforeBuild" Inputs="$(ShaderSource)" Outputs="$(ShaderBinary)">
    <!-- Windows SDK のバージョンは環境ごとに違うので固定パスにしない。
         インストール済みのうち一番新しいものを使う。-p:FxcPath=... で明示指定もできる。 -->
    <ItemGroup Condition="'$(FxcPath)' == ''">
      <FxcCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\fxc.exe" />
    </ItemGroup>
    <PropertyGroup Condition="'$(FxcPath)' == '' And '@(FxcCandidate)' != ''">
      <FxcCandidates>@(FxcCandidate->'%(FullPath)')</FxcCandidates>
      <FxcPath>$(FxcCandidates.Substring($([MSBuild]::Add($(FxcCandidates.LastIndexOf(';')), 1))))</FxcPath>
    </PropertyGroup>

    <Warning Condition="!Exists('$(FxcPath)')"
             Text="fxc.exe が見つかりませんでした。コミット済みの .cso を使用します。HLSL を変更した場合は -p:FxcPath=... で指定してください。" />
    <Exec Condition="Exists('$(FxcPath)')"
          Command="&quot;$(FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(ShaderBinary)&quot; &quot;$(ShaderSource)&quot;" />
  </Target>

  <!-- ビルド後にYMM4のプラグインフォルダにdllをコピーする -->
  <Target Name="CopyToYmm4" AfterTargets="Build" Condition="'$(YMM4DirPath)' != '' And Exists('$(YMM4DirPath)')">
    <MakeDir Directories="$(YMM4DirPath)user\plugin\$(ProjectName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YMM4DirPath)user\plugin\$(ProjectName)" />
  </Target>

</Project>
